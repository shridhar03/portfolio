# Client environment. Only VITE_* vars are exposed to the browser: never put secrets here.
# In dev, /api is proxied to the server by Vite. In production, point this at the deployed API.
VITE_API_URL=
# Public origin of the deployed site, used for canonical URLs, Open Graph tags, sitemap.xml and
# robots.txt at build time, e.g. https://your-domain.com (no trailing slash).
VITE_SITE_URL=
