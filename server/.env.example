# Server environment. Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (free M0 tier is enough).
# Leave empty in local dev to use in-memory storage seeded from shared/projects.json.
# Required in production. After setting it, run: npm run seed -w server
MONGODB_URI=

# Resend (free tier) for contact-form notifications. Leave empty to save messages without emailing.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend. The default works only for sending to your own Resend account email.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Added in Phase 5:
# ANTHROPIC_API_KEY=
